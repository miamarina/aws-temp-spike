@startuml architecture-project
' Lecture scriptum generator: proposed project (target) architecture.
' Based on 05-project-plan-and-feasibility.md: tested baseline (S3, Lambda,
' FFmpeg, external ASR + LLM API) plus the proposed, not yet tested
' intake/workflow/publishing services. Same style as architecture-flow.puml.
'
' Icons: AWS Icons for PlantUML v23.1 (official AWS Architecture Icons)
' https://github.com/awslabs/aws-icons-for-plantuml
' Render: plantuml -tsvg architecture-project.puml   (needs network for the !includes)

!define AWSPuml https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v23.1/dist
!include AWSPuml/AWSCommon.puml
!include AWSPuml/AWSSimplified.puml

' ---- style overrides (must come before the icon includes) ----
' icon on a transparent background, plain label underneath
!definelong AWSEntityColoring(e_stereo)
skinparam rectangle<<e_stereo>> {
    BackgroundColor transparent
    BorderColor transparent
    Shadowing false
    FontSize 13
    FontColor #232F3E
}
!enddefinelong
!function $AWSImg($service)
!return %call_user_func("$" + $service + "IMG", "1.3")
!endfunction
!definelong AWSEntity(e_alias, e_label, e_techn, e_color, e_sprite, e_stereo)
rectangle "$AWSImg(e_sprite)\ne_label" <<e_stereo>> as e_alias
!enddefinelong
!definelong AWSEntity(e_alias, e_label, e_techn, e_descr, e_color, e_sprite, e_stereo)
rectangle "$AWSImg(e_sprite)\ne_label" <<e_stereo>> as e_alias
!enddefinelong

!include AWSPuml/General/User.puml
!include AWSPuml/General/GenericApplication.puml
!include AWSPuml/NetworkingContentDelivery/CloudFront.puml
!include AWSPuml/NetworkingContentDelivery/APIGateway.puml
!include AWSPuml/Compute/Lambda.puml
!include AWSPuml/Storage/SimpleStorageService.puml
!include AWSPuml/ApplicationIntegration/SimpleQueueService.puml
!include AWSPuml/ApplicationIntegration/StepFunctions.puml
!include AWSPuml/Database/DynamoDB.puml
!include AWSPuml/ManagementGovernance/SystemsManager.puml

' ---- groups ----
<style>
.cluster { HorizontalAlignment left }
.nested { HorizontalAlignment left }
.external { HorizontalAlignment left }
</style>
skinparam rectangle<<cluster>> {
    BackgroundColor #E5F5FD
    BorderColor #AEB6BE
    RoundCorner 16
    FontSize 12
    FontStyle plain
    FontColor #232F3E
}
skinparam rectangle<<nested>> {
    BackgroundColor #EBF3E7
    BorderColor #AEB6BE
    RoundCorner 16
    FontSize 12
    FontStyle plain
    FontColor #232F3E
}
skinparam rectangle<<external>> {
    BackgroundColor #F7F8FA
    BorderColor #AEB6BE
    BorderStyle dashed
    RoundCorner 16
    FontSize 12
    FontStyle plain
    FontColor #232F3E
}
skinparam legend {
    BackgroundColor #FFFFFF
    BorderColor #AEB6BE
    FontSize 12
    FontColor #232F3E
}

skinparam arrow {
    Color #7B8894
    FontColor #232F3E
    FontSize 12
}
skinparam CaptionFontSize 20
skinparam CaptionFontColor #232F3E
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
left to right direction

' ---- user ----
User(user, "User\nupload, read + search", "")

' ---- static web hosting + upload ----
rectangle "Web (static hosting, no login)" <<cluster>> as web_grp {
  CloudFront(cdn, "CloudFront\nHTTPS", "")
  SimpleStorageService(site, "S3 · static site\nreader + upload page", "")
  APIGateway(api, "API Gateway\nHTTP API", "")
  rectangle "API Lambdas" <<nested>> as api_grp {
    Lambda(upload_fn, "Upload\npresigned PUT URL", "")
    Lambda(status_fn, "Lectures + status\nGET /lectures, /jobs/{id}", "")
  }
}

' ---- intake ----
rectangle "Upload + intake" <<cluster>> as intake_grp {
  SimpleStorageService(raw, "S3 · recordings\nuploaded videos", "")
  SimpleQueueService(queue, "SQS\nS3 upload events", "")
  Lambda(intake_fn, "Intake\nstart workflow", "")
  DynamoDB(ddb, "DynamoDB\njobs, status, lecture list", "")
}

' ---- processing workflow ----
rectangle "Processing workflow (Step Functions Standard)" <<cluster>> as wf_grp {
  StepFunctions(sfn, "Step Functions\nstages, retries", "")
  SystemsManager(ssm, "SSM Parameter Store\nprovider API key (SecureString)", "")
  Lambda(prepare_fn, "Prepare\nFFmpeg: extract audio,\nsplit into chunks", "")
  SimpleStorageService(s3chunks, "S3 · chunks/\naudio + manifest", "")
  rectangle "Parallel video processing (Map state over chunks)" <<nested>> as map_grp {
    Lambda(wn, "Chunk worker n\naudio chunk → ASR", "")
    Lambda(w1, "Chunk worker 1\naudio chunk → ASR", "")
    Lambda(w2, "Chunk worker 2\naudio chunk → ASR", "")
  }
  SimpleStorageService(s3trans, "S3 · transcripts/\none per chunk", "")
  Lambda(merge_fn, "Merge\nafter all chunks\noffsets + segment IDs", "")
  SimpleStorageService(s3merged, "S3 · transcript.json\nmerged", "")
  Lambda(gen_fn, "Generate scriptum\nchapters, summary,\nkey terms", "")
  Lambda(pub_fn, "Validate + publish\nsegment refs, timestamps\n→ DynamoDB: PUBLISHED", "")
}

' ---- external inference ----
rectangle "External AI inference API (HTTPS)" <<external>> as ai_grp {
  GenericApplication(asr, "Speech-to-text model\n(ASR)", "")
  GenericApplication(llm, "Large language model\n(LLM)", "")
}

' ---- results + state ----
rectangle "Results" <<cluster>> as res_grp {
  SimpleStorageService(published, "S3 · published scripta\n+ per-lecture search index\n(served via CloudFront)", "")
}

' ---- flow ----
user --> cdn
cdn --> site
cdn --> api
api --> upload_fn
api --> status_fn
upload_fn .[#7B8894].> raw
raw --> queue
queue --> intake_fn
intake_fn --> sfn
sfn --> prepare_fn
prepare_fn --> s3chunks
s3chunks --> w1
s3chunks --> w2
s3chunks --> wn
w1 --> s3trans
w2 --> s3trans
wn --> s3trans
s3trans --> merge_fn
w1 .[#7B8894].> asr
w2 .[#7B8894].> asr
wn .[#7B8894].> asr
merge_fn --> s3merged
s3merged --> gen_fn
gen_fn .[#7B8894].> llm
gen_fn --> pub_fn
pub_fn --> published
' single dash = same column: DynamoDB sits under Intake
intake_fn .[#7B8894]> ddb
status_fn .[#7B8894].> ddb
' layout only: SSM sits in the Step Functions column
ssm -[hidden]> sfn



@enduml
