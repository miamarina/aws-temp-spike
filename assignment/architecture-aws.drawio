          <mxGeometry height="36" width="36" x="1255" y="577" as="geometry" />
        </mxCell>
        <mxCell id="marker-6" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="36" width="36" x="747" y="619" as="geometry" />
        </mxCell>
        <mxCell id="marker-7" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;arcSize=25;" value="7" vertex="1">
          <mxGeometry height="36" width="36" x="735" y="1098" as="geometry" />
        </mxCell>
        <mxCell id="marker-8" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="8" vertex="1">
          <mxGeometry height="36" width="36" x="215" y="755" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
