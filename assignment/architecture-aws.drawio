        </mxCell>
        <mxCell id="explanations" parent="1" style="rounded=0;html=1;fillColor=#F2F5F8;strokeColor=#D4DDE5;" value="" vertex="1">
          <mxGeometry height="1332" width="620" x="1498" y="64" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-1" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="1" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="80" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Web entry and reader&lt;/b&gt;&lt;br&gt;&lt;br&gt;CloudFront serves the reader and saved results from private S3 origins using OAC. /api/* goes to the HTTP API with caching disabled. No application login; reading/search/export makes no AI calls." vertex="1">
          <mxGeometry height="140" width="512.5" x="1571" y="90" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-2" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="2" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="244" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Create a job&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload Lambda registers metadata in DynamoDB before returning a short-lived signed POST policy. Media is uploaded directly to S3; enforce byte/duration/job limits and configure S3 CORS." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="244" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-3" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="3" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="408" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Private work storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;S3 holds recordings, chunks, offset manifests, transcripts, drafts and benchmark receipts. B1-B3 and C1 access these artifacts through scoped roles; workflow payloads contain IDs and S3 references." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="408" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-4" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="4" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="572" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Buffered, duplicate-safe intake&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only recordings/ ObjectCreated events enter SQS Standard. Intake validates and claims the job, then starts/reconciles one stable workflow identity. Repeated events reuse the same job; exhausted intake deliveries go to its DLQ." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="572" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-5" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="5" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="736" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Workflow control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Step Functions Standard coordinates B1 prepare -&gt; B2 Map -&gt; B3 merge -&gt; C1 notes -&gt; C2 publish. Purple lines mean workflow order, not direct Lambda calls. Wait outside Lambda; bound retries. Each on-demand invocation must fit 15 minutes." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="736" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-6" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="900" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Bounded parallel transcription&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use n=1,2,5 per Map plus five active ASR calls maximum across all lectures. Reserve shared request/audio allowance before calling Groq. Catch chunk errors inside each iteration; save completed output. Measure achieved concurrency." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="900" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-7" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="7" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="1064" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Notes, publication and failure&lt;/b&gt;&lt;br&gt;&lt;br&gt;C1 uses bounded text sections plus synthesis and shared token pacing. C2 validates references/times and writes files before final status. Chunk or notes failures retain useful transcript as PARTIAL. No usable text -&gt; FAILED; skip LLM. Partial is not complete success." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="1064" as="geometry" />
        </mxCell>
        <mxCell id="panel-number-8" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="8" vertex="1">
          <mxGeometry height="36" width="36" x="1518" y="1228" as="geometry" />
        </mxCell>
        <mxCell id="panel-text-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#26384A;fontStyle=0;" value="&lt;b&gt;Shared services and evaluation&lt;/b&gt;&lt;br&gt;&lt;br&gt;DynamoDB owns jobs, claims, catalog and quota state; Parameter Store keeps the server-side key. CloudWatch and S3 receipts record timings/attempts. Test 5/10/20/30 minutes; 90-minute time/cost is labelled stage-based extrapolation only. Quotas/funding need verification." vertex="1">
          <mxGeometry height="150" width="524" x="1571" y="1228" as="geometry" />
        </mxCell>
        <mxCell id="marker-1" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="1" vertex="1">
          <mxGeometry height="36" width="36" x="209" y="267" as="geometry" />
        </mxCell>
        <mxCell id="marker-2" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="2" vertex="1">
          <mxGeometry height="36" width="36" x="638" y="244" as="geometry" />
        </mxCell>
        <mxCell id="marker-3" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="3" vertex="1">
          <mxGeometry height="36" width="36" x="842" y="240" as="geometry" />
        </mxCell>
        <mxCell id="marker-4" parent="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;" value="4" vertex="1">
